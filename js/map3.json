{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 500,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "title": {
        "text": "National Parks Across Australia",
        "subtitle": "Locations of parks included in the dataset",
        "anchor": "start",
        "fontSize": 24,
        "subtitleFontSize": 14,
        "offset": 14
    },
    "projection": {
        "type": "mercator"
    },
    "layer": [
        {
            "data": {
                "url": "js/australia_states.json",
                "format": {
                    "type": "topojson",
                    "feature": "STE_2026_AUST_GDA2020"
                }
            },
            "mark": {
                "type": "geoshape",
                "fill": "#E9EEE9",
                "stroke": "black",
                "strokeWidth": 1
            }
        },
        {
            "data": {
                "values": [
                    {
                        "Abbreviation": "NSW",
                        "Longitude": 147,
                        "Latitude": -32
                    },
                    {
                        "Abbreviation": "VIC",
                        "Longitude": 144.5,
                        "Latitude": -37.1
                    },
                    {
                        "Abbreviation": "QLD",
                        "Longitude": 144,
                        "Latitude": -22.5
                    },
                    {
                        "Abbreviation": "SA",
                        "Longitude": 135,
                        "Latitude": -30
                    },
                    {
                        "Abbreviation": "WA",
                        "Longitude": 122,
                        "Latitude": -26
                    },
                    {
                        "Abbreviation": "TAS",
                        "Longitude": 146.6,
                        "Latitude": -42
                    },
                    {
                        "Abbreviation": "NT",
                        "Longitude": 133.5,
                        "Latitude": -20
                    }
                ]
            },
            "mark": {
                "type": "text",
                "fontSize": 12,
                "fontWeight": "bold",
                "color": "#253D2C",
                "opacity": 1
            },
            "encoding": {
                "longitude": {
                    "field": "Longitude",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "Latitude",
                    "type": "quantitative"
                },
                "text": {
                    "field": "Abbreviation",
                    "type": "nominal"
                }
            }
        },
        {
            "data": {
                "url": "data/australia_national_parks_clean.csv"
            },
            "mark": {
                "type": "circle",
                "size": 28,
                "color": "#4F7D5B",
                "opacity": 0.65,
                "stroke": "#FFFFFF",
                "strokeWidth": 0.3
            },
            "encoding": {
                "longitude": {
                    "field": "Longitude",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "Latitude",
                    "type": "quantitative"
                },
                "tooltip": [
                    {
                        "field": "Name",
                        "title": "National park"
                    },
                    {
                        "field": "State_Territory",
                        "title": "State or territory"
                    },
                    {
                        "field": "Year_Established",
                        "type": "quantitative",
                        "title": "Year established",
                        "format": "d"
                    }
                ]
            }
        },
        {
            "data": {
                "values": [
                    {
                        "Longitude": 149.12,
                        "Latitude": -35.47,
                        "LabelLongitude": 152.0,
                        "LabelLatitude": -35.3
                    }
                ]
            },
            "mark": {
                "type": "rule",
                "color": "#253D2C",
                "strokeWidth": 1.3
            },
            "encoding": {
                "longitude": {
                    "field": "Longitude",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "Latitude",
                    "type": "quantitative"
                },
                "longitude2": {
                    "field": "LabelLongitude"
                },
                "latitude2": {
                    "field": "LabelLatitude"
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "Longitude": 149.12,
                        "Latitude": -35.47
                    }
                ]
            },
            "mark": {
                "type": "point",
                "filled": true,
                "size": 35,
                "color": "#253D2C"
            },
            "encoding": {
                "longitude": {
                    "field": "Longitude",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "Latitude",
                    "type": "quantitative"
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "Abbreviation": "ACT",
                        "Longitude": 152.0,
                        "Latitude": -35.3
                    }
                ]
            },
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 5,
                "fontSize": 12,
                "fontWeight": "bold",
                "color": "#253D2C"
            },
            "encoding": {
                "longitude": {
                    "field": "Longitude",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "Latitude",
                    "type": "quantitative"
                },
                "text": {
                    "field": "Abbreviation",
                    "type": "nominal"
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": null
        },
        "axis": {
            "labelFontSize": 14,
            "titleFontSize": 15
        },
        "legend": {
            "labelFontSize": 14,
            "titleFontSize": 14
        }
    }
}