{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "Weekly Participation Across Australia",
    "subtitle": "Adults active at least once per week, 2025",
    "anchor": "start",
    "fontSize": 16,
    "subtitleFontSize": 11,
    "offset": 12
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11
    }
  },
  "data": {
    "url": "js/australia_states.json",
    "format": {
      "type": "topojson",
      "feature": "STE_2026_AUST_GDA2020"
    }
  },
  "transform": [
    {
      "lookup": "properties.STE_NAME26",
      "from": {
        "data": {
          "url": "data/state_participation.csv"
        },
        "key": "State",
        "fields": [
          "Participation"
        ]
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "Participation",
      "type": "quantitative",
      "scale": {
        "scheme": "greens"
      },
      "title": "Weekly participation (%)",
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 180
      }
    },
    "tooltip": [
      {
        "field": "properties.STE_NAME26",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "Participation",
        "type": "quantitative",
        "format": ".1f",
        "title": "Participation (%)"
      }
    ]
  }
}