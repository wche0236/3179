{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 500,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "Weekly Participation Across Australia",
    "subtitle": "Adults active at least once per week, 2025",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 14,
    "offset": 14
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "js/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2026_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "lookup": "properties.STE_NAME26",
          "from": {
            "data": {
              "url": "data/state_participation.csv"
            },
            "key": "State",
            "fields": [
              "Participation"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "black",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "Participation",
          "type": "quantitative",
          "scale": {
            "scheme": "blues"
          },
          "title": "Weekly participation (%)",
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "gradientLength": 180
          }
        },
        "tooltip": [
          {
            "field": "properties.STE_NAME26",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "Participation",
            "type": "quantitative",
            "format": ".1f",
            "title": "Participation (%)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "Longitude": 149.12,
            "Latitude": -35.47,
            "LabelLongitude": 153.0,
            "LabelLatitude": -35.3
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#173B2B",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "LabelLongitude"
        },
        "latitude2": {
          "field": "LabelLatitude"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Longitude": 149.12,
            "Latitude": -35.47
          }
        ]
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 35,
        "color": "#173B2B"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "data/state_participation.csv"
      },
      "transform": [
        {
          "filter": "datum.State !== 'Australian Capital Territory'"
        },
        {
          "calculate": "datum.State === 'New South Wales' ? 147.0 : datum.State === 'Victoria' ? 144.5 : datum.State === 'Queensland' ? 145.5 : datum.State === 'South Australia' ? 135.5 : datum.State === 'Western Australia' ? 121.0 : datum.State === 'Tasmania' ? 146.5 : datum.State === 'Northern Territory' ? 133.5 : null",
          "as": "LabelLongitude"
        },
        {
          "calculate": "datum.State === 'New South Wales' ? -32.8 : datum.State === 'Victoria' ? -37.1 : datum.State === 'Queensland' ? -23.5 : datum.State === 'South Australia' ? -30.5 : datum.State === 'Western Australia' ? -26.0 : datum.State === 'Tasmania' ? -42.0 : datum.State === 'Northern Territory' ? -19.5 : null",
          "as": "LabelLatitude"
        },
        {
          "calculate": "datum.State === 'New South Wales' ? 'NSW' : datum.State === 'Victoria' ? 'VIC' : datum.State === 'Queensland' ? 'QLD' : datum.State === 'South Australia' ? 'SA' : datum.State === 'Western Australia' ? 'WA' : datum.State === 'Tasmania' ? 'TAS' : datum.State === 'Northern Territory' ? 'NT' : ''",
          "as": "Abbreviation"
        },
        {
          "filter": "isValid(datum.LabelLongitude)"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#173B2B"
      },
      "encoding": {
        "longitude": {
          "field": "LabelLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "LabelLatitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Abbreviation",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Label": "ACT",
            "Longitude": 153.0,
            "Latitude": -35.3
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#173B2B"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "Label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 15
    },
    "legend": {
      "labelFontSize": 14,
      "titleFontSize": 14
    }
  }
}