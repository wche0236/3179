{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 500,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "title": {
        "text": "Gender Composition Across Activities",
        "subtitle": "Percentage of male and female participants in the top 10 activities, 2025",
        "anchor": "start",
        "fontSize": 20,
        "subtitleFontSize": 14,
        "offset": 14
    },
    "data": {
        "url": "data/gender_participation.csv"
    },
    "encoding": {
        "y": {
            "field": "Activity",
            "type": "nominal",
            "title": null,
            "sort": [
                "Walking",
                "Bush walking",
                "Running",
                "Swimming",
                "Cycling",
                "Golf",
                "Surfing",
                "Fishing",
                "Kayaking",
                "Mountain climbing"
            ],
            "axis": {
                "labelFontSize": 11,
                "labelLimit": 230
            }
        }
    },
    "layer": [
        {
            "mark": {
                "type": "rule",
                "strokeWidth": 2,
                "color": "#B0B0B0"
            },
            "encoding": {
                "x": {
                    "field": "Male",
                    "type": "quantitative",
                    "title": "Gender composition (%)",
                    "scale": {
                        "domain": [
                            0,
                            100
                        ]
                    }
                },
                "x2": {
                    "field": "Female"
                }
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 120,
                "opacity": 1
            },
            "encoding": {
                "x": {
                    "field": "Male",
                    "type": "quantitative"
                },
                "color": {
                    "datum": "Male",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "Male",
                            "Female"
                        ],
                        "range": [
                            "#4F7B94",
                            "#D98E65"
                        ]
                    },
                    "legend": {
                        "title": "Gender",
                        "orient": "bottom",
                        "direction": "horizontal",
                        "columns": 2,
                        "labelFontSize": 11,
                        "titleFontSize": 12,
                        "symbolSize": 100,
                        "offset": 10
                    }
                },
                "tooltip": [
                    {
                        "field": "Activity",
                        "type": "nominal",
                        "title": "Activity"
                    },
                    {
                        "field": "Male",
                        "type": "quantitative",
                        "title": "Male (%)",
                        "format": ".1f"
                    }
                ]
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 120,
                "opacity": 1
            },
            "encoding": {
                "x": {
                    "field": "Female",
                    "type": "quantitative"
                },
                "color": {
                    "datum": "Female",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "Male",
                            "Female"
                        ],
                        "range": [
                            "#4F7B94",
                            "#D98E65"
                        ]
                    }
                },
                "tooltip": [
                    {
                        "field": "Activity",
                        "type": "nominal",
                        "title": "Activity"
                    },
                    {
                        "field": "Female",
                        "type": "quantitative",
                        "title": "Female (%)",
                        "format": ".1f"
                    }
                ]
            }
        }
    ],
    "config": {
        "font": "Source Sans 3",
        "view": {
            "stroke": null
        },
        "title": {
            "fontSize": 20,
            "subtitleFontSize": 14,
            "fontWeight": "bold",
            "subtitleFontWeight": "normal",
            "anchor": "start",
            "offset": 14
        },
        "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal"
        },
        "legend": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal"
        }
    }
}