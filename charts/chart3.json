{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 400,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "title": {
        "text": "Why Australians Get Active Changes With Age",
        "subtitle": "Selected motivations by age group, percentage of participants",
        "anchor": "start",
        "fontSize": 20,
        "subtitleFontSize": 14,
        "offset": 14
    },
    "data": {
        "url": "data/motivation_age.csv",
        "format": {
            "type": "csv",
            "parse": {
                "Age": "string",
                "Motivation": "string",
                "Percentage": "number"
            }
        }
    },
    "transform": [
        {
            "calculate": "trim(toString(datum.Age))",
            "as": "Clean Age"
        },
        {
            "calculate": "toNumber(replace(datum['Clean Age'], /[^0-9].*$/, ''))",
            "as": "Starting Age"
        },
        {
            "calculate": "datum['Starting Age'] == 15 ? 1 : datum['Starting Age'] == 18 ? 2 : datum['Starting Age'] == 25 ? 3 : datum['Starting Age'] == 35 ? 4 : datum['Starting Age'] == 45 ? 5 : datum['Starting Age'] == 55 ? 6 : datum['Starting Age'] == 65 ? 7 : null",
            "as": "Age Position"
        },
        {
            "filter": "isValid(datum['Age Position'])"
        }
    ],
    "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
    },
    "encoding": {
        "x": {
            "field": "Age Position",
            "type": "ordinal",
            "scale": {
                "domain": [
                    1,
                    2,
                    3,
                    4,
                    5,
                    6,
                    7
                ],
                "reverse": false
            },
            "axis": {
                "title": "Age group",
                "labelAngle": 0,
                "labelExpr": "datum.value == 1 ? '15-17' : datum.value == 2 ? '18-24' : datum.value == 3 ? '25-34' : datum.value == 4 ? '35-44' : datum.value == 5 ? '45-54' : datum.value == 6 ? '55-64' : '65+'",
                "labelFontSize": 14
            }
        },
        "y": {
            "field": "Motivation",
            "type": "nominal",
            "sort": [
                "Physical health or fitness",
                "Fun and enjoyment",
                "Lose or maintain weight",
                "Be outdoors or enjoy nature",
                "Social reasons",
                "Mental health or therapy",
                "Sense of achievement",
                "Hobby",
                "Training purposes",
                "Learn a new skill"
            ],
            "title": null,
            "axis": {
                "labelLimit": 210
            }
        },
        "color": {
            "field": "Percentage",
            "type": "quantitative",
            "scale": {
                "domain": [
                    0,
                    75
                ],
                "range": [
                    "#F4EAF2",
                    "#DBC1DB",
                    "#BEA0C4",
                    "#9A7A9F",
                    "#6D4E70"
                ]
            },
            "legend": {
                "fontWeight": "bold",
                "orient": "bottom",
                "direction": "horizontal",
                "gradientLength": 220,
                "title": "Participants (%)",
                "values": [
                    0,
                    75
                ],
                "labelExpr": "datum.value === 0 ? '0%' : datum.value === 75 ? '75%' : null"
            }
        },
        "tooltip": [
            {
                "field": "Age",
                "title": "Age group"
            },
            {
                "field": "Motivation",
                "title": "Motivation"
            },
            {
                "field": "Percentage",
                "type": "quantitative",
                "format": ".1f",
                "title": "Participants (%)"
            }
        ]
    },
    "config": {
        "font": "Source Sans 3",
        "view": {
            "stroke": null
        },
        "title": {
            "fontSize": 20,
            "subtitleFontSize": 14,
            "fontWeight": "bold",
            "subtitleFontWeight": "normal",
            "anchor": "start",
            "offset": 14
        },
        "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal"
        },
        "legend": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal"
        }
    }
}