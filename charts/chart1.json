{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 500,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "title": {
        "text": "Most Popular Outdoor Activities",
        "subtitle": "Estimated participants in selected activities, 2025",
        "anchor": "start",
        "fontSize": 24,
        "subtitleFontSize": 14,
        "offset": 14
    },
    "data": {
        "url": "data/activity_participation.csv",
        "format": {
            "type": "csv",
            "parse": {
                "Participants": "number"
            }
        }
    },
    "encoding": {
        "y": {
            "field": "Activity",
            "type": "nominal",
            "sort": {
                "field": "Participants",
                "op": "max",
                "order": "descending"
            },
            "title": null,
            "axis": {
                "labelFontSize": 11,
                "labelLimit": 135
            }
        },
        "x": {
            "field": "Participants",
            "type": "quantitative",
            "title": "Estimated participants",
            "axis": {
                "format": "~s"
            },
            "scale": {
                "zero": true,
                "nice": true
            }
        }
    },
    "layer": [
        {
            "mark": {
                "type": "bar",
                "height": 2,
                "color": "orange"
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 100,
                "color": "orange"
            },
            "encoding": {
                "tooltip": [
                    {
                        "field": "Activity",
                        "type": "nominal",
                        "title": "Activity"
                    },
                    {
                        "field": "Participants",
                        "type": "quantitative",
                        "title": "Estimated participants",
                        "format": ","
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "joinaggregate": [
                        {
                            "op": "max",
                            "field": "Participants",
                            "as": "MaxParticipants"
                        }
                    ]
                },
                {
                    "filter": "datum.Participants == datum.MaxParticipants"
                }
            ],
            "mark": {
                "type": "point",
                "filled": true,
                "size": 170,
                "color": "#B85C00",
                "stroke": "#FFFFFF",
                "strokeWidth": 1.5
            }
        },
        {
            "transform": [
                {
                    "joinaggregate": [
                        {
                            "op": "max",
                            "field": "Participants",
                            "as": "MaxParticipants"
                        }
                    ]
                },
                {
                    "filter": "datum.Participants == datum.MaxParticipants"
                }
            ],
            "mark": {
                "type": "text",
                "align": "center",
                "baseline": "bottom",
                "dy": -12,
                "fontSize": 15,
                "fontWeight": "bold",
                "color": "#B85C00"
            },
            "encoding": {
                "text": {
                    "field": "Participants",
                    "type": "quantitative",
                    "format": ".3s"
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": null
        },
        "axis": {
            "labelFontSize": 14,
            "titleFontSize": 15
        },
        "legend": {
            "labelFontSize": 14,
            "titleFontSize": 14
        }
    }
}