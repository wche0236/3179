{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": 500,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "title": {
        "text": "Most Popular Outdoor Activities",
        "subtitle": "Estimated participants in the top 10 activities, 2025",
        "anchor": "start",
        "fontSize": 20,
        "subtitleFontSize": 14,
        "offset": 14
    },
    "data": {
        "url": "data/activity_participation.csv",
        "format": {
            "type": "csv",
            "parse": {
                "Participants": "number"
            }
        }
    },
    "transform": [
        {
            "calculate": "datum.Activity === 'Walking (Recreational)' ? 'Walking' : datum.Activity",
            "as": "DisplayActivity"
        }
    ],
    "encoding": {
        "y": {
            "field": "DisplayActivity",
            "type": "nominal",
            "sort": {
                "field": "Participants",
                "op": "max",
                "order": "descending"
            },
            "title": null,
            "axis": {
                "labelFontSize": 11,
                "labelLimit": 200
            }
        },
        "x": {
            "field": "Participants",
            "type": "quantitative",
            "title": "Estimated participants",
            "axis": {
                "format": "~s"
            },
            "scale": {
                "zero": true,
                "domainMax": 13000000
            }
        }
    },
    "layer": [
        {
            "mark": {
                "type": "bar",
                "height": 2,
                "color": "#C29B38"
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 120,
                "color": "#C29B38",
                "tooltip": true
            },
            "encoding": {
                "tooltip": [
                    {
                        "field": "Activity",
                        "type": "nominal",
                        "title": "Activity"
                    },
                    {
                        "field": "Participants",
                        "type": "quantitative",
                        "title": "Estimated participants",
                        "format": ","
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "joinaggregate": [
                        {
                            "op": "max",
                            "field": "Participants",
                            "as": "MaxParticipants"
                        }
                    ]
                },
                {
                    "filter": "datum.Participants === datum.MaxParticipants"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "dx": 12,
                "fontSize": 14,
                "fontWeight": "bold",
                "color": "#000000"
            },
            "encoding": {
                "text": {
                    "value": "11.3M"
                }
            }
        },
        {
            "transform": [
                {
                    "joinaggregate": [
                        {
                            "op": "max",
                            "field": "Participants",
                            "as": "MaxParticipants"
                        }
                    ]
                },
                {
                    "filter": "datum.Participants === datum.MaxParticipants"
                }
            ],
            "mark": {
                "type": "text",
                "align": "right",
                "baseline": "bottom",
                "dx": -10,
                "dy": -12,
                "fontSize": 12,
                "fontWeight": "bold",
                "color": "#000000"
            },
            "encoding": {
                "text": {
                    "value": "THE CLEAR LEADER"
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "Activity": "Walking",
                        "Participants": 4500000,
                        "annotation": "Walking attracts nearly 3 times more than the next activity"
                    }
                ]
            },
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "middle",
                "fontWeight": "bold",
                "fontSize": 12,
                "color": "#000000",
                "dx": 0,
                "dy": 35
            },
            "encoding": {
                "x": {
                    "field": "Participants",
                    "type": "quantitative"
                },
                "y": {
                    "field": "Activity",
                    "type": "nominal"
                },
                "text": {
                    "field": "annotation"
                }
            }
        }
    ],
    "config": {
        "font": "Source Sans 3",
        "view": {
            "stroke": null
        },
        "title": {
            "fontSize": 20,
            "subtitleFontSize": 14,
            "fontWeight": "bold",
            "subtitleFontWeight": "normal",
            "anchor": "start",
            "offset": 14
        },
        "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal"
        },
        "legend": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titleFontWeight": "normal"
        }
    }
}