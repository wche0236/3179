{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "background": "#f7fafc",
    "width": "container",
    "height": 380,
    "padding": {
        "left": 10,
        "right": 15,
        "top": 10,
        "bottom": 5
    },
    "title": {
        "text": "How Has Participation in Different Activities Changed?",
        "subtitle": "Estimated adult participants by activity, 2017–2025.",
        "anchor": "start",
        "font": "Arial",
        "fontSize": 20,
        "subtitleFontSize": 12,
        "offset": 14,
        "color": "#243447"
    },
    "params": [
        {
            "name": "yearWindow",
            "select": {
                "type": "interval",
                "encodings": [
                    "x"
                ]
            },
            "views": [
                "yearOverview"
            ]
        }
    ],
    "data": {
        "url": "data/activity_trend_top5.csv",
        "format": {
            "type": "csv",
            "parse": {
                "PeriodOrder": "number",
                "Participants": "number"
            }
        }
    },
    "transform": [
        {
            "filter": "isValid(datum.PeriodOrder) && isValid(datum.Participants)"
        },
        {
            "calculate": "2017 + datum.PeriodOrder",
            "as": "Year"
        },
        {
            "calculate": "isValid(datum.Activity) ? datum.Activity : 'Unknown'",
            "as": "ActivityLabel"
        }
    ],
    "vconcat": [
        {
            "width": "container",
            "height": 290,
            "transform": [
                {
                    "filter": {
                        "param": "yearWindow"
                    }
                }
            ],
            "layer": [
                {
                    "mark": {
                        "type": "line",
                        "point": {
                            "filled": true,
                            "size": 65
                        },
                        "strokeWidth": 2.5
                    },
                    "encoding": {
                        "x": {
                            "field": "Year",
                            "type": "quantitative",
                            "scale": {
                                "domain": [
                                    2017,
                                    2025
                                ],
                                "nice": false
                            },
                            "axis": {
                                "title": "Year",
                                "format": "d",
                                "tickMinStep": 1,
                                "labelFontSize": 10,
                                "grid": false
                            }
                        },
                        "y": {
                            "field": "Participants",
                            "type": "quantitative",
                            "scale": {
                                "zero": true
                            },
                            "axis": {
                                "title": "Estimated adult participants",
                                "format": "~s",
                                "grid": true,
                                "gridColor": "#E7ECE6"
                            }
                        },
                        "color": {
                            "field": "ActivityLabel",
                            "type": "nominal",
                            "scale": {
                                "domain": [
                                    "Walking",
                                    "Swimming",
                                    "Running",
                                    "Cycling",
                                    "Bush walking"
                                ],
                                "range": [
                                    "#4E7A6E",
                                    "#6B4C7A",
                                    "#C29B38",
                                    "#8A6F5A",
                                    "#928EB1"
                                ]
                            },
                            "legend": {
                                "title": "Activity",
                                "orient": "top",
                                "direction": "horizontal",
                                "columns": 5,
                                "labelFontSize": 11,
                                "titleFontSize": 12,
                                "labelLimit": 180,
                                "symbolType": "stroke",
                                "symbolStrokeWidth": 3
                            }
                        },
                        "detail": {
                            "field": "ActivityLabel",
                            "type": "nominal"
                        },
                        "tooltip": [
                            {
                                "field": "ActivityLabel",
                                "type": "nominal",
                                "title": "Activity"
                            },
                            {
                                "field": "Period",
                                "type": "nominal",
                                "title": "Survey period"
                            },
                            {
                                "field": "Year",
                                "type": "quantitative",
                                "title": "Year",
                                "format": "d"
                            },
                            {
                                "field": "Participants",
                                "type": "quantitative",
                                "title": "Estimated participants",
                                "format": ",.0f"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "yearOverview",
            "width": "container",
            "height": 65,
            "mark": {
                "type": "area",
                "opacity": 0.25,
                "color": "#4E7A6E",
                "line": {
                    "color": "#4E7A6E",
                    "strokeWidth": 1.5
                }
            },
            "encoding": {
                "x": {
                    "field": "Year",
                    "type": "quantitative",
                    "scale": {
                        "domain": [
                            2017,
                            2025
                        ],
                        "nice": false
                    },
                    "axis": {
                        "title": "Drag across years to filter the line chart",
                        "format": "d",
                        "tickMinStep": 1,
                        "labelAngle": 0,
                        "grid": false
                    }
                },
                "y": {
                    "aggregate": "sum",
                    "field": "Participants",
                    "type": "quantitative",
                    "axis": null,
                    "scale": {
                        "zero": true
                    }
                },
                "tooltip": [
                    {
                        "field": "Year",
                        "type": "quantitative",
                        "title": "Year",
                        "format": "d"
                    },
                    {
                        "aggregate": "sum",
                        "field": "Participants",
                        "type": "quantitative",
                        "title": "Total estimated participants",
                        "format": ",.0f"
                    }
                ]
            },
            "params": [
                {
                    "name": "yearBrush",
                    "select": {
                        "type": "interval",
                        "encodings": [
                            "x"
                        ]
                    }
                }
            ]
        }
    ],
    "resolve": {
        "scale": {
            "x": "shared"
        }
    },
    "config": {
        "view": {
            "stroke": null
        },
        "font": "Arial",
        "axis": {
            "labelColor": "#4B554D",
            "titleColor": "#303830",
            "domainColor": "#CDD5CC",
            "tickColor": "#CDD5CC"
        }
    }
}